# ==========================================
# BACKEND (EXPRESS.JS) .ENV.EXAMPLE
# Copy this file to .env (dev) and .env.production (prod)
# ==========================================

PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# ==========================================
# Database (Prisma + MySQL)
# ==========================================
#
# LOCAL DEV (Laragon default — user 'root', no password, db 'dfd_agency'):
DATABASE_URL="mysql://root@localhost:3306/dfd_agency?connection_limit=5"
#
# DOCKER (if you use the bundled docker-compose):
# DATABASE_URL="mysql://root@localhost:3306/dfd_agency?connection_limit=5"
#
# PRODUCTION (Aiven or other managed MySQL):
# DATABASE_URL="mysql://USER:PASSWORD@HOST:PORT/DBNAME?ssl-mode=REQUIRED&connection_limit=5"

# ==========================================
# Security (JWT)
# Must be >= 32 chars or server refuses to start
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ==========================================
JWT_SECRET="replace_me_with_a_long_random_string_at_least_32_chars_long"
JWT_EXPIRES_IN="30d"

# Next.js ISR Revalidation Token
# MUST MATCH NEXT_ISR_TOKEN IN FRONTEND
NEXT_ISR_TOKEN="replace_me_with_a_long_random_string"

# ==========================================
# Cloud Storage (Cloudinary) — optional
# ==========================================
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"
CLOUDINARY_URL="cloudinary://api_key:api_secret@cloud_name"

# ==========================================
# Email (Resend) — optional
# ==========================================
RESEND_API_KEY="re_xxx"
EMAIL_FROM="DFD Agency <hello@dfdagency.com>"

# ==========================================
# Google Drive Service Account (JSON stringified) — optional
# ==========================================
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
GOOGLE_DRIVE_PARENT_FOLDER_ID="your_drive_folder_id"

# ==========================================
# Telegram Bot API — optional (fallback to console)
# ==========================================
TELEGRAM_BOT_TOKEN="your_bot_token"
TELEGRAM_CHAT_ID="your_group_chat_id"

# ==========================================
# Agency WhatsApp (for admin-side notifications to internal team)
# ==========================================
AGENCY_WHATSAPP="628123456789"
