# DFD Agency API — environment template.
# Copy to .env and fill in real values. Never commit .env.

APP_ENV=development
PORT=8080
LOG_LEVEL=info
ENABLE_ACCESS_LOG=true

# Supabase / PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dfd_agency?sslmode=disable
DATABASE_MIN_CONNS=1
DATABASE_MAX_CONNS=10

# Must be at least 32 characters.
JWT_SECRET=replace_me_with_a_long_random_string_at_least_32_chars_long
JWT_TTL_HOURS=720

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://dfd-agency-website.vercel.app,https://dfdagencywebsite.vercel.app

# Email (Resend) — optional.
RESEND_API_KEY=
EMAIL_FROM=DFD Agency <hello@dfdagency.com>

# Supabase Storage — optional.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=dfd-media

# Notifications — optional.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
AGENCY_WHATSAPP=

# Midnight database backup (pg_dump must be on PATH). Off by default.
BACKUP_ENABLED=false
BACKUP_DIR=backups
BACKUP_RETENTION_DAYS=30

# Google Drive service account (JSON stringified) — optional, legacy.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_PARENT_FOLDER_ID=
